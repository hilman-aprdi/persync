PORT=5000
NODE_ENV=production
APP_URL=https://your-domain.com
CORS_ORIGIN=https://your-domain.com
DATABASE_URL=postgresql://postgres:your_secure_password_here@postgres:5432/persync
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_CLIENT_ID=your_google_client_id_here
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN_DAYS=7
TRUST_PROXY=1
JSON_BODY_LIMIT=1mb
AUTO_RUN_DB_INIT=false
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX_REQUESTS=10
GENERATE_RATE_LIMIT_WINDOW_MS=60000
GENERATE_RATE_LIMIT_MAX_REQUESTS=6
GEMINI_RETRY_ATTEMPTS=2
GEMINI_RETRY_BASE_DELAY_MS=1200
SESSION_MUTATION_RATE_LIMIT_WINDOW_MS=60000
SESSION_MUTATION_RATE_LIMIT_MAX_REQUESTS=10
